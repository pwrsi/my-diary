@import url("https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap");

* {
  font-family: "Pixelify Sans";
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  color: #b1889c;
}

/* hidden */
.hidden {
  display: none;
}

/* calendar */
/* decor */
.decor-top-left {
  width: 15%;
  position: absolute;
  z-index: 100;
  top: -20px;
  left: -20px;
  transform: rotate(30deg);
}

.decor-bottom-right {
  width: 15%;
  position: absolute;
  z-index: 100;
  bottom: -20px;
  right: -20px;
  transform: rotate(30deg);
}

body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.container {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 5px;
  background-image: url(../images/pink-pattern.png);
  background-size: 258px;
  background-position: center;
  border: 3px solid #c1e584;
}

.content {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 0px;
  gap: 5px;
}

.top {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  background-color: #ffdae4;
  border: 3px solid #ffb4c9;
  width: 100%;
}

.top button, .top span {
  font-size: 1.6rem;
  background: none;
  border: none;
  color: #ffffff;
  text-transform:uppercase;
  text-shadow: -1px -1px 0 #fd88a9, 1px -1px 0 #fd88a9, -1px 2px 0 #fd88a9, 1px 1px 0 #fd88a9;
  transition: 0.3s ease;
  cursor: pointer;
}

.arrows button {
  color: #c1e584;
}

.top button:hover, .top .month-year-label:hover span {
  transform: scale(0.95);
}

.month-year-label {
  display: flex;
  flex-direction: column;
  z-index: 2;
  line-height: 22px;
}

.arrows {
  position: absolute;
  display: flex;
  gap: 280px;
}

.days-container {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 80%;
  margin: 0 10px;
  background-color: #fff6f8;
  padding: 10px 15px 5px 15px; 
  border: 3px solid #ffb4c9;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 30px;
  font-weight: bold;
  margin-bottom: 8px;
}

.weekday {
  text-align: center;
  color: #a6ca69;
}

.days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10px 20px;
}

.day {
  padding: 6px 5px;
  text-align: center;
  transition: 0.2s ease;
  cursor: pointer;
  color: #fd88a9;
}

.current-day {
  background-color: #c1e584;
  border-radius: 50%;
  color: #ffffff;
}

.day:hover {
  background-color: #c1e58471;
  border-radius: 36px;
}

.day:active { 
  transform: scale(0.8);
}

/* month year panel */
.month-year-panel {
  background-color: #ffb4c9;
  position: absolute;
  z-index: 100;
  width: 200px;
  height: 500px;
  overflow: hidden;
  /* display: flex;
  flex-direction: column;
  align-items: center; */
  padding: 5px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  display: flex;
  justify-content: end;
  align-items: end;
  margin-bottom: 5px;
  width: 100%
}

.close-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  padding-bottom: 2px;
  background-color: #fff;
  border: 2px solid #a6ca69;
  color: #a6ca69;
  font-size: 1.1rem;
  cursor: pointer;
}

.month-year-container {
  display: flex;
  justify-content: center;
  gap: 20px;
  background-color: #ffdae4;
  width: 98%;
}

.months-container, .years-container {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.months-container button, .years-container button {
  padding: 2px 10px;
}

